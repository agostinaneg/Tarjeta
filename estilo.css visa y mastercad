body {
    font-family: Arial;
    background-color: #eeeeee;
}

.contenedor {
    width: 600px;
    margin: 100px auto;
    background-color: white;
    padding: 30px;
    display: flex;
    gap: 20px;
}

.campo {
    display: flex;
    flex-direction: column;
}

label {
    font-size: 14px;
    margin-bottom: 5px;
}

input {
    padding: 10px;
    width: 230px;
}

button {
    padding: 10px;
}
